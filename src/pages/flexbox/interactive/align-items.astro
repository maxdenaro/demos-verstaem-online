---
import InteractiveLayout from "@/layouts/InteractiveLayout.astro";
import Child from "@/components/base/Child.astro";
import Radio from "@/components/base/Radio.astro";

const title = "Flexbox: align-items";
const description =
  "align-items выравнивает элементы вдоль поперечной оси. Разница видна, когда элементы имеют разную высоту.";
---

<InteractiveLayout title={title} description={description}>
  <div class="demo-interactive" id="container" slot="preview">
    <Child>Блок 1</Child>
    <Child>Блок 2</Child>
    <Child>Блок 3</Child>
  </div>

  <div slot="controls">
    <div class="radio-group" role="radiogroup" aria-label="align-items">
      <Radio name="align" value="stretch" label="stretch" checked />
      <Radio name="align" value="flex-start" label="flex-start" />
      <Radio name="align" value="flex-end" label="flex-end" />
      <Radio name="align" value="center" label="center" />
      <Radio name="align" value="baseline" label="baseline" />
    </div>

    <p class="interactive__description" id="description">
      Все элементы растягиваются на всю высоту контейнера по поперечной оси.
    </p>
  </div>
</InteractiveLayout>

<style is:global>
  .radio-group {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
  }

  .demo-interactive {
    display: flex;
    align-items: stretch;
    gap: 12px;
    min-height: 240px;
    transition: 0.3s;
  }

  .demo-interactive .child {
    flex: 1 1 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-secondary);
  }

  .demo-interactive .child:nth-child(2) {
    padding: 40px 16px;
  }

  .demo-interactive .child:nth-child(3) {
    padding: 72px 16px;
  }

  .demo-interactive.flex-start {
    align-items: flex-start;
  }

  .demo-interactive.flex-end {
    align-items: flex-end;
  }

  .demo-interactive.center {
    align-items: center;
  }

  .demo-interactive.baseline {
    align-items: baseline;
  }
</style>

<script is:inline>
  const radios = document.querySelectorAll('[name="align"]');
  const container = document.getElementById("container");
  const description = document.getElementById("description");

  const texts = {
    stretch:
      "Все элементы растягиваются на всю высоту контейнера по поперечной оси.",
    "flex-start":
      "Элементы выравниваются по верхнему краю поперечной оси и сохраняют свою высоту.",
    "flex-end":
      "Элементы прижимаются к нижнему краю поперечной оси — разница в высоте видна сверху.",
    center:
      "Элементы выравниваются по центру поперечной оси.",
    baseline:
      "Элементы выравниваются по базовой линии первого текста.",
  };

  const render = () => {
    const value = document.querySelector('[name="align"]:checked').value;
    container.classList.remove("flex-start", "flex-end", "center", "baseline");
    container.classList.add(value);

    window.renderInteractiveCode([
      ".demo-interactive {",
      "  display: flex;",
      `  align-items: ${value};`,
      "  gap: 12px;",
      "}",
    ]);

    description.textContent = texts[value];
  };

  render();
  radios.forEach((radio) => radio.addEventListener("change", render));
</script>