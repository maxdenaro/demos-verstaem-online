---
import InteractiveLayout from "@/layouts/InteractiveLayout.astro";
import Child from "@/components/base/Child.astro";

const title = "Flexbox: justify-content";
const description =
  "justify-content распределяет свободное пространство вдоль главной оси.";
---

<InteractiveLayout title={title} description={description}>
  <div class="demo-interactive" id="container" slot="preview">
    <Child>Блок 1</Child>
    <Child>Блок 2</Child>
    <Child>Блок 3</Child>
  </div>

  <div slot="controls">
    <div class="radio-group" role="radiogroup" aria-label="justify-content">
      <label class="radio">
        <input class="radio__input" type="radio" name="justify" value="flex-start" checked />
        <span class="radio__box"></span>
        <span class="radio__label">flex-start</span>
      </label>

      <label class="radio">
        <input class="radio__input" type="radio" name="justify" value="flex-end" />
        <span class="radio__box"></span>
        <span class="radio__label">flex-end</span>
      </label>

      <label class="radio">
        <input class="radio__input" type="radio" name="justify" value="center" />
        <span class="radio__box"></span>
        <span class="radio__label">center</span>
      </label>

      <label class="radio">
        <input class="radio__input" type="radio" name="justify" value="space-between" />
        <span class="radio__box"></span>
        <span class="radio__label">space-between</span>
      </label>

      <label class="radio">
        <input class="radio__input" type="radio" name="justify" value="space-around" />
        <span class="radio__box"></span>
        <span class="radio__label">space-around</span>
      </label>

      <label class="radio">
        <input class="radio__input" type="radio" name="justify" value="space-evenly" />
        <span class="radio__box"></span>
        <span class="radio__label">space-evenly</span>
      </label>
    </div>

    <p class="interactive__description" id="description">
      Элементы прижимаются к началу главной оси.
    </p>
  </div>
</InteractiveLayout>

<style is:global>
  .radio-group {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
  }

  .radio {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    user-select: none;
  }

  .radio__input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .radio__box {
    position: relative;
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    border: 2px solid var(--text-tretiary);
    border-radius: 50%;
    background: transparent;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .radio__box::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text-secondary);
    transform: translate(-50%, -50%) scale(0);
    transition: transform 0.2s ease;
  }

  .radio__label {
    font-size: 14px;
    color: var(--text-tretiary);
    transition: color 0.2s ease;
  }

  .radio:hover {
    .radio__box {
      border-color: var(--accent-color);
    }

    .radio__label {
      color: var(--text-primary);
    }
  }

  .radio__input:checked + .radio__box {
    background: var(--accent-color);
    border-color: var(--accent-color);

    &::after {
      transform: translate(-50%, -50%) scale(1);
    }
  }

  .radio__input:focus-visible + .radio__box {
    border-color: var(--accent-color);
    box-shadow: 0 0 0 3px var(--focus-color);
  }

  .demo-interactive {
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 12px;
    min-height: 200px;
    transition: 0.3s;
  }

  .demo-interactive .child {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-secondary);
  }

  .demo-interactive .child:nth-child(1) {
    width: 90px;
  }

  .demo-interactive .child:nth-child(2) {
    width: 130px;
  }

  .demo-interactive .child:nth-child(3) {
    width: 180px;
  }

  .demo-interactive.flex-end {
    justify-content: flex-end;
  }

  .demo-interactive.center {
    justify-content: center;
  }

  .demo-interactive.space-between {
    justify-content: space-between;
  }

  .demo-interactive.space-around {
    justify-content: space-around;
  }

  .demo-interactive.space-evenly {
    justify-content: space-evenly;
  }
</style>

<script is:inline>
  const radios = document.querySelectorAll('[name="justify"]');
  const container = document.getElementById("container");
  const description = document.getElementById("description");

  const texts = {
    "flex-start": "Элементы прижимаются к началу главной оси.",
    "flex-end": "Элементы прижимаются к концу главной оси.",
    center: "Элементы группируются по центру главной оси.",
    "space-between":
      "Первый и последний элементы у краёв, остальное пространство распределяется равномерно между ними.",
    "space-around":
      "Каждый элемент получает одинаковые отступы слева и справа от себя.",
    "space-evenly":
      "Пространство распределяется равномерно между элементами и по краям контейнера.",
  };

  const render = () => {
    const value = document.querySelector('[name="justify"]:checked').value;
    container.classList.remove(
      "flex-end",
      "center",
      "space-between",
      "space-around",
      "space-evenly"
    );
    container.classList.add(value);

    window.renderInteractiveCode([
      ".demo-interactive {",
      "  display: flex;",
      `  justify-content: ${value};`,
      "  gap: 12px;",
      "}",
    ]);

    description.textContent = texts[value];
  };

  render();
  radios.forEach((radio) => radio.addEventListener("change", render));
</script>