---
import InteractiveLayout from "@/layouts/InteractiveLayout.astro";

const title = "Flexbox: прижать группу к правому краю через margin-left: auto";
const description =
  "margin-left: auto забирает всё свободное пространство слева от группы кнопок и прижимает её к правому краю панели.";
---

<InteractiveLayout title={title} description={description}>
  <div class="toolbar" slot="preview">
    <span class="toolbar__title">Документы</span>

    <div class="toolbar__actions">
      <button class="toolbar__button" type="button">Фильтр</button>
      <button class="toolbar__button toolbar__button--primary" type="button">Создать</button>
    </div>
  </div>

  <div slot="controls">
    <label class="checkbox">
      <input class="checkbox__input" type="checkbox" id="toggle" checked />
      <span class="checkbox__box"></span>
      <span class="checkbox__label">Включить margin-left: auto</span>
    </label>

    <p class="interactive__description" id="description">
      Автоматический отступ забирает всё свободное место и прижимает группу кнопок к правому краю.
    </p>
  </div>
</InteractiveLayout>

<style is:global>
  .toolbar {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    padding: 20px 24px;
    background: var(--bg-secondary);
    border-radius: var(--border-radius);
  }

  .toolbar__title {
    font-family: var(--title-font-family);
    font-size: 20px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .toolbar__actions {
    display: flex;
    align-items: center;
    gap: 12px;
    transition: 0.3s;
  }

  .toolbar__actions.margin-auto {
    margin-left: auto;
  }

  .toolbar__button {
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-tretiary);
    background: transparent;
    border: 1px solid var(--text-tretiary);
    border-radius: 10px;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .toolbar__button:hover {
    color: var(--text-primary);
    border-color: var(--text-primary);
  }

  .toolbar__button--primary {
    color: var(--text-secondary);
    background: var(--accent-color);
    border-color: var(--accent-color);
  }

  .toolbar__button--primary:hover {
    color: var(--text-secondary);
    border-color: var(--accent-hover-color);
    background: var(--accent-hover-color);
  }
</style>

<script is:inline>
  const toggle = document.getElementById("toggle");
  const actions = document.querySelector(".toolbar__actions");
  const description = document.getElementById("description");

  const render = () => {
    const on = toggle.checked;
    actions.classList.toggle("margin-auto", on);

    window.renderInteractiveCode([
      ".toolbar {",
      "  display: flex;",
      "}",
      "",
      ".toolbar__actions {",
      `  margin-left: ${on ? "auto" : "0"};`,
      "}",
    ]);

    description.textContent = on
      ? "Автоматический отступ забирает всё свободное место и прижимает группу кнопок к правому краю."
      : "Отступа нет: группа кнопок стоит сразу после заголовка у левого края.";
  };

  render();
  toggle.addEventListener("change", render);
</script>