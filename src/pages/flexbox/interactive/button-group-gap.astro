---
import InteractiveLayout from "@/layouts/InteractiveLayout.astro";

const title = "Flexbox: одинаковое расстояние в группе через gap";
const description =
  "Расстояние между кнопками задаёт контейнер через gap. Количество кнопок меняется — расстояние между ними всегда одинаковое, без margin у самих кнопок.";
---

<InteractiveLayout title={title} description={description}>
  <div class="actions" id="actions" slot="preview">
    <button class="actions__button" type="button">Изменить</button>
    <button class="actions__button" type="button">Удалить</button>
    <button class="actions__button" type="button">Отменить</button>
  </div>

  <div slot="controls">
    <div class="buttons-row">
      <button class="control-button" type="button" id="add">+ Добавить кнопку</button>
      <button class="control-button" type="button" id="remove">− Убрать кнопку</button>
    </div>

    <p class="interactive__description" id="description">
      Три кнопки. Между ними одинаковый отступ, заданный контейнером: gap: 12px.
    </p>
  </div>
</InteractiveLayout>

<style is:global>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    width: 100%;
    padding: 16px;
    background: var(--bg-secondary);
    border-radius: var(--border-radius);
  }

  .actions__button {
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-tretiary);
    background: transparent;
    border: 1px solid var(--text-tretiary);
    border-radius: 10px;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .actions__button:hover {
    color: var(--text-primary);
    border-color: var(--text-primary);
  }

  .buttons-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .control-button {
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-secondary);
    background: var(--accent-color);
    border: none;
    border-radius: 10px;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .control-button:hover {
    background: var(--accent-hover-color);
  }
</style>

<script is:inline>
  const actions = document.getElementById("actions");
  const addButton = document.getElementById("add");
  const removeButton = document.getElementById("remove");
  const description = document.getElementById("description");

  const labels = ["Добавить", "Поделиться", "Скопировать", "Закрепить", "Архивировать"];

  const count = () => actions.querySelectorAll(".actions__button").length;

  const plural = (n) => {
    const mod10 = n % 10;
    const mod100 = n % 100;
    if (mod10 === 1 && mod100 !== 11) return "кнопка";
    if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) return "кнопки";
    return "кнопок";
  };

  const render = () => {
    const n = count();

    window.renderInteractiveCode([
      ".actions {",
      "  display: flex;",
      "  gap: 12px;",
      "}",
      "",
      `// сейчас в группе: ${n} ${plural(n)}`,
    ]);

    description.textContent = `${n} ${plural(n)}. Расстояние между ними одинаковое — его задаёт контейнер: gap: 12px.`;
  };

  const add = () => {
    const i = count();
    if (i >= labels.length) return;

    const button = document.createElement("button");
    button.type = "button";
    button.className = "actions__button";
    button.textContent = labels[i];
    actions.appendChild(button);
    render();
  };

  const remove = () => {
    const buttons = actions.querySelectorAll(".actions__button");
    if (buttons.length <= 1) return;
    buttons[buttons.length - 1].remove();
    render();
  };

  render();
  addButton.addEventListener("click", add);
  removeButton.addEventListener("click", remove);
</script>