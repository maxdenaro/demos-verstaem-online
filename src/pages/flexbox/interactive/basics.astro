---
import InteractiveLayout from "@/layouts/InteractiveLayout.astro";
import Child from "@/components/base/Child.astro";

const title = "Flexbox: основы";
const description =
  "Как меняется расположение элементов, когда контейнер становится flex-контейнером.";
---

<InteractiveLayout title={title} description={description}>
  <div class="demo-interactive" id="container" slot="preview">
    <Child>Блок 1</Child>
    <Child>Блок 2</Child>
    <Child>Блок 3</Child>
  </div>

  <div slot="controls">
    <label class="checkbox">
      <input class="checkbox__input" type="checkbox" id="toggle" />
      <span class="checkbox__box"></span>
      <span class="checkbox__label">Включить Flexbox</span>
    </label>

    <p class="interactive__description" id="description">
      Сейчас элементы являются обычными блочными и располагаются друг под другом.
    </p>
  </div>
</InteractiveLayout>

<style is:global>
  .demo-interactive {
    transition: 0.3s;
  }

  .demo-interactive .child {
    background: var(--bg-secondary);
  }

  .demo-interactive .child:not(:last-child) {
    margin-bottom: 12px;
  }

  .demo-interactive.flex {
    display: flex;
    gap: 12px;
  }

  .demo-interactive.flex .child {
    flex: 1 1 0;
    margin-bottom: 0;
  }
</style>

<script is:inline>
  const toggle = document.getElementById("toggle");
  const container = document.getElementById("container");
  const description = document.getElementById("description");

  const render = () => {
    container.classList.toggle("flex", toggle.checked);

    window.renderInteractiveCode(
      toggle.checked
        ? [".demo-interactive {", "  display: flex;", "  gap: 12px;", "}"]
        : [".demo-interactive {", "  display: block;", "}"]
    );

    description.textContent = toggle.checked
      ? "Контейнер стал flex-контейнером. Его дочерние элементы теперь располагаются вдоль главной оси (по умолчанию — слева направо)."
      : "Сейчас элементы являются обычными блочными и располагаются друг под другом.";
  };

  render();
  toggle.addEventListener("change", render);
</script>