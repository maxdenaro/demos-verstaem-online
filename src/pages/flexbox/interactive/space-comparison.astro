---
import InteractiveLayout from "@/layouts/InteractiveLayout.astro";
import Child from "@/components/base/Child.astro";
import Radio from "@/components/base/Radio.astro";

const title = "Flexbox: space-between, space-around, space-evenly";
const description =
  "Три способа распределить свободное пространство по главной оси. Разница — в том, где появляются отступы.";
---

<InteractiveLayout title={title} description={description}>
  <div class="demo-interactive" id="container" slot="preview">
    <Child>1</Child>
    <Child>2</Child>
    <Child>3</Child>
  </div>

  <div slot="controls">
    <div class="radio-group" role="radiogroup" aria-label="justify-content">
      <Radio name="justify" value="space-between" label="space-between" checked />
      <Radio name="justify" value="space-around" label="space-around" />
      <Radio name="justify" value="space-evenly" label="space-evenly" />
    </div>

    <p class="interactive__description" id="description">
      Первый элемент у левого края, последний — у правого. Свободное пространство — только между элементами.
    </p>
  </div>
</InteractiveLayout>

<style is:global>
  .radio-group {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
  }

  .demo-interactive {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 260px;
    transition: 0.3s;
  }

  .demo-interactive .child {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-secondary);
  }

  .demo-interactive .child:nth-child(1) {
    width: 90px;
  }

  .demo-interactive .child:nth-child(2) {
    width: 130px;
  }

  .demo-interactive .child:nth-child(3) {
    width: 180px;
  }

  .demo-interactive.space-around {
    justify-content: space-around;
  }

  .demo-interactive.space-evenly {
    justify-content: space-evenly;
  }
</style>

<script is:inline>
  const radios = document.querySelectorAll('[name="justify"]');
  const container = document.getElementById("container");
  const description = document.getElementById("description");

  const texts = {
    "space-between":
      "Первый элемент у левого края, последний — у правого. Свободное пространство — только между элементами.",
    "space-around":
      "Вокруг каждого элемента одинаковые отступы слева и справа. Поэтому у краёв контейнера отступ вдвое меньше.",
    "space-evenly":
      "Пространство делится поровну: одинаковые отступы между элементами и по краям контейнера.",
  };

  const render = () => {
    const value = document.querySelector('[name="justify"]:checked').value;
    container.classList.remove("space-around", "space-evenly");
    if (value !== "space-between") container.classList.add(value);

    window.renderInteractiveCode([
      ".demo-interactive {",
      "  display: flex;",
      `  justify-content: ${value};`,
      "  gap: 12px;",
      "}",
    ]);

    description.textContent = texts[value];
  };

  render();
  radios.forEach((radio) => radio.addEventListener("change", render));
</script>