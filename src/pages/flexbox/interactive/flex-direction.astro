---
import InteractiveLayout from "@/layouts/InteractiveLayout.astro";
import Child from "@/components/base/Child.astro";

const title = "Flexbox: flex-direction";
const description =
  "Свойство flex-direction задаёт направление главной оси: элементы могут идти слева направо, справа налево, сверху вниз или снизу вверх.";
---

<InteractiveLayout title={title} description={description}>
  <div class="demo-interactive" id="container" slot="preview">
    <Child>Блок 1</Child>
    <Child>Блок 2</Child>
    <Child>Блок 3</Child>
  </div>

  <div slot="controls">
    <div class="radio-group" role="radiogroup" aria-label="flex-direction">
      <label class="radio">
        <input class="radio__input" type="radio" name="direction" value="row" checked />
        <span class="radio__box"></span>
        <span class="radio__label">row</span>
      </label>

      <label class="radio">
        <input class="radio__input" type="radio" name="direction" value="row-reverse" />
        <span class="radio__box"></span>
        <span class="radio__label">row-reverse</span>
      </label>

      <label class="radio">
        <input class="radio__input" type="radio" name="direction" value="column" />
        <span class="radio__box"></span>
        <span class="radio__label">column</span>
      </label>

      <label class="radio">
        <input class="radio__input" type="radio" name="direction" value="column-reverse" />
        <span class="radio__box"></span>
        <span class="radio__label">column-reverse</span>
      </label>
    </div>

    <p class="interactive__description" id="description">
      Главная ось направлена слева направо — элементы идут в том же порядке, в котором заданы в разметке.
    </p>
  </div>
</InteractiveLayout>

<style is:global>
  .radio-group {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
  }

  .radio {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    user-select: none;
  }

  .radio__input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .radio__box {
    position: relative;
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    border: 2px solid var(--text-tretiary);
    border-radius: 50%;
    background: transparent;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .radio__box::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text-secondary);
    transform: translate(-50%, -50%) scale(0);
    transition: transform 0.2s ease;
  }

  .radio__label {
    font-size: 14px;
    color: var(--text-tretiary);
    transition: color 0.2s ease;
  }

  .radio:hover {
    .radio__box {
      border-color: var(--accent-color);
    }

    .radio__label {
      color: var(--text-primary);
    }
  }

  .radio__input:checked + .radio__box {
    background: var(--accent-color);
    border-color: var(--accent-color);

    &::after {
      transform: translate(-50%, -50%) scale(1);
    }
  }

  .radio__input:focus-visible + .radio__box {
    border-color: var(--accent-color);
    box-shadow: 0 0 0 3px var(--focus-color);
  }

  .demo-interactive {
    transition: 0.3s;
  }

  .demo-interactive .child {
    background: var(--bg-secondary);
  }

  .demo-interactive.row,
  .demo-interactive.row-reverse,
  .demo-interactive.column,
  .demo-interactive.column-reverse {
    display: flex;
    gap: 12px;
  }

  .demo-interactive.row {
    flex-direction: row;
  }

  .demo-interactive.row-reverse {
    flex-direction: row-reverse;
  }

  .demo-interactive.column {
    flex-direction: column;
  }

  .demo-interactive.column-reverse {
    flex-direction: column-reverse;
  }

  .demo-interactive.row .child,
  .demo-interactive.row-reverse .child {
    flex: 1 1 0;
  }
</style>

<script is:inline>
  const radios = document.querySelectorAll('[name="direction"]');
  const container = document.getElementById("container");
  const description = document.getElementById("description");

  const texts = {
    row: "Главная ось направлена слева направо — элементы идут в том же порядке, в котором заданы в разметке.",
    "row-reverse":
      "Главная ось направлена справа налево — элементы идут в обратном порядке.",
    column: "Главная ось направлена сверху вниз — элементы располагаются друг под другом.",
    "column-reverse":
      "Главная ось направления снизу вверх — элементы идут в обратном порядке снизу вверх.",
  };

  const render = () => {
    const value = document.querySelector('[name="direction"]:checked').value;
    container.classList.remove("row", "row-reverse", "column", "column-reverse");
    container.classList.add(value);

    window.renderInteractiveCode([
      ".demo-interactive {",
      "  display: flex;",
      `  flex-direction: ${value};`,
      "  gap: 12px;",
      "}",
    ]);

    description.textContent = texts[value];
  };

  render();
  radios.forEach((radio) => radio.addEventListener("change", render));
</script>