---
import Head from "@/components/base/Head.astro";

const { title = "Интерактивные демо", description = "" } = Astro.props;
---

<html lang="ru">
  <Head title={title} description={description} />

  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    color: #222;
    background: #fff;
    line-height: 1.5;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
  }

  a {
    color: #5b5ce2;
  }
</style>
