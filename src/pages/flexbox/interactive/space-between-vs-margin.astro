---
import InteractiveLayout from "@/layouts/InteractiveLayout.astro";
import Radio from "@/components/base/Radio.astro";

const title = "Flexbox: space-between или margin-left: auto";
const description =
  "Оба способа прижимают кнопки к правому краю, но смысл разный: space-between распределяет пространство между всеми элементами, а margin-left: auto забирает его одним блоком.";
---

<InteractiveLayout title={title} description={description}>
  <div class="toolbar" slot="preview">
    <span class="toolbar__title">Заголовок</span>

    <button class="toolbar__button" type="button">Фильтр</button>
    <button class="toolbar__button toolbar__button--primary" type="button"
      >Сохранить</button
    >
  </div>

  <Fragment slot="controls">
    <div
      class="radio-group"
      role="radiogroup"
      aria-label="Способ распределения пространства"
    >
      <Radio
        name="method"
        value="space-between"
        label="justify-content: space-between"
      />
      <Radio
        name="method"
        value="margin-auto"
        label="margin-left: auto"
        checked
      />
    </div>

    <p class="interactive__description" id="description">
      Автоматический отступ забирает всё свободное место и прижимает группу
      кнопок к правому краю.
    </p>
  </Fragment>
</InteractiveLayout>

<style is:global>
  .radio-group {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
  }

  .toolbar {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    padding: 20px 24px;
    background: var(--bg-secondary);
    border-radius: var(--border-radius);
    transition: 0.3s;
  }

  .toolbar.space-between {
    justify-content: space-between;
  }

  .toolbar__title {
    font-family: var(--title-font-family);
    font-size: 20px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .toolbar__actions {
    display: flex;
    align-items: center;
    gap: 12px;
    transition: 0.3s;
  }

  .toolbar.space-between .toolbar__button:first-of-type {
    margin-left: 0;
  }

  .toolbar.margin-auto .toolbar__button:first-of-type {
    margin-left: auto;
  }

  .toolbar__button {
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-tretiary);
    background: transparent;
    border: 1px solid var(--text-tretiary);
    border-radius: 10px;
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .toolbar__button:hover {
    color: var(--text-primary);
    border-color: var(--text-primary);
  }

  .toolbar__button--primary {
    color: var(--text-secondary);
    background: var(--accent-color);
    border-color: var(--accent-color);
  }

  .toolbar__button--primary:hover {
    color: var(--text-secondary);
    border-color: var(--accent-hover-color);
    background: var(--accent-hover-color);
  }

  @media (max-width: 600px) {
    .toolbar {
      gap: 8px;
      padding: 12px 16px;
    }

    .toolbar__title {
      font-size: 13px;
    }

    .toolbar__button {
      padding: 6px 10px;
      font-size: 13px;
    }

    .toolbar__button--primary {
      display: none;
    }
  }
</style>

<script is:inline>
  const radios = document.querySelectorAll('[name="method"]');
  const toolbar = document.querySelector(".toolbar");
  const description = document.getElementById("description");

  const texts = {
    "space-between":
      "space-between распределяет свободное пространство между всеми flex-элементами: заголовок у левого края, группа кнопок у правого.",
    "margin-auto":
      "margin-left: auto забирает всё свободное место одним блоком — группой кнопок. Заголовок остаётся на месте, кнопки прижимаются к правому краю.",
  };

  const render = () => {
    const value = document.querySelector('[name="method"]:checked').value;
    toolbar.classList.toggle("space-between", value === "space-between");
    toolbar.classList.toggle("margin-auto", value === "margin-auto");

    const code =
      value === "space-between"
        ? [
            ".toolbar {",
            "  display: flex;",
            "  justify-content: space-between;",
            "}",
          ]
        : [
            ".toolbar {",
            "  display: flex;",
            "}",
            "",
            ".toolbar__actions {",
            "  margin-left: auto;",
            "}",
          ];

    window.renderInteractiveCode(code);

    description.textContent = texts[value];
  };

  render();
  radios.forEach((radio) => radio.addEventListener("change", render));
</script>
