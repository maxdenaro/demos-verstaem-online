---
const { name, value, label, checked = false } = Astro.props;
---

<label class="radio">
  <input
    class="radio__input"
    type="radio"
    name={name}
    value={value}
    checked={checked}
  />
  <span class="radio__box"></span>
  <span class="radio__label">{label}</span>
</label>

<style lang="scss">
  .radio {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    user-select: none;

    &:hover {
      .radio__box {
        border-color: var(--accent-color);
      }

      .radio__label {
        color: var(--text-primary);
      }
    }
  }

  .radio__input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;

    &:checked + .radio__box {
      background: var(--accent-color);
      border-color: var(--accent-color);

      &::after {
        transform: translate(-50%, -50%) scale(1);
      }
    }

    &:focus-visible + .radio__box {
      border-color: var(--accent-color);
      box-shadow: 0 0 0 3px var(--focus-color);
    }
  }

  .radio__box {
    position: relative;
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    border: 2px solid var(--text-tretiary);
    border-radius: 50%;
    background: transparent;
    transition: background 0.2s ease, border-color 0.2s ease;

    &::after {
      content: "";
      position: absolute;
      top: 50%;
      left: 50%;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--text-secondary);
      transform: translate(-50%, -50%) scale(0);
      transition: transform 0.2s ease;
    }
  }

  .radio__label {
    font-size: 14px;
    color: var(--text-tretiary);
    transition: color 0.2s ease;
  }
</style>