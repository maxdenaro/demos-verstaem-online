---
import InteractiveLayout from "@/layouts/InteractiveLayout.astro";
import Child from "@/components/base/Child.astro";

const title = "Flexbox: flex-wrap: wrap-reverse";
const description =
  "В отличие от wrap строки заполняются снизу вверх: при переносе новые строки появляются над предыдущими, поэтому первый элемент оказывается в нижнем ряду.";
---

<InteractiveLayout title={title} description={description}>
  <div class="demo-interactive" id="container" slot="preview">
    <Child>1</Child>
    <Child>2</Child>
    <Child>3</Child>
    <Child>4</Child>
    <Child>5</Child>
  </div>

  <Fragment slot="controls">
    <label class="checkbox">
      <input class="checkbox__input" type="checkbox" id="toggle" />
      <span class="checkbox__box"></span>
      <span class="checkbox__label">Включить flex-wrap: wrap-reverse</span>
    </label>

    <label class="range">
      <span class="range__label">
        Ширина контейнера: <b id="width-value">100%</b>
      </span>
      <input
        class="range__input"
        id="width-range"
        type="range"
        min="25"
        max="100"
        value="100"
        step="1"
      />
    </label>

    <p class="interactive__description" id="description">
      flex-wrap: wrap-reverse выключен — элементы остаются в одну строку, а при нехватке места сжимаются.
    </p>
  </Fragment>
</InteractiveLayout>

<style is:global>
  .demo-interactive {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-start;
    gap: 12px;
    height: 300px;
    padding: 16px;
    border-radius: var(--border-radius);
    background: var(--bg-secondary);
    transition: 0.3s;
  }

  .demo-interactive .child {
    flex: 0 1 auto;
    min-width: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .demo-interactive.wrap-reverse {
    flex-wrap: wrap-reverse;
  }

  .demo-interactive.wrap-reverse .child {
    flex: 0 0 auto;
    min-width: 0;
  }

  .demo-interactive .child:nth-child(1) {
    width: 120px;
  }

  .demo-interactive .child:nth-child(2) {
    width: 150px;
  }

  .demo-interactive .child:nth-child(3) {
    width: 130px;
  }

  .demo-interactive .child:nth-child(4) {
    width: 160px;
  }

  .demo-interactive .child:nth-child(5) {
    width: 140px;
  }

  .range {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .range__label {
    font-size: 14px;
    color: var(--text-tretiary);
  }

  .range__label b {
    color: var(--text-primary);
  }

  .range__input {
    width: 100%;
    accent-color: var(--accent-color);
  }
</style>

<script is:inline>
  const container = document.getElementById("container");
  const description = document.getElementById("description");
  const toggle = document.getElementById("toggle");
  const range = document.getElementById("width-range");
  const widthValue = document.getElementById("width-value");

  const render = () => {
    const wrap = toggle.checked;
    const width = Number(range.value);

    container.classList.toggle("wrap-reverse", wrap);
    container.style.width = `${width}%`;
    widthValue.textContent = `${width}%`;

    window.renderInteractiveCode([
      ".demo-interactive {",
      "  display: flex;",
      `  flex-wrap: ${wrap ? "wrap-reverse" : "nowrap"};`,
      "  gap: 12px;",
      `  width: ${width}%;`,
      "}",
    ]);

    if (!wrap) {
      description.textContent =
        "flex-wrap: wrap-reverse выключен — элементы всегда остаются в одну строку, а при нехватке места сжимаются.";
      return;
    }

    const rows = new Set();
    [...container.children].forEach((child) => rows.add(child.offsetTop));
    const rowCount = rows.size;

    description.textContent =
      rowCount === 1
        ? "wrap-reverse включён, но сейчас элементы помещаются в одну строку. Сузьте контейнер, чтобы увидеть перенос."
        : "Строки заполняются снизу вверх: новые строки появляются над предыдущими, поэтому первый элемент оказывается в нижнем ряду.";
  };

  render();
  toggle.addEventListener("change", render);
  range.addEventListener("input", render);
  range.addEventListener("change", render);
</script>